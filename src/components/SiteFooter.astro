---
import { site } from '../data/site';
---

<footer class="border-t border-line mt-16 no-print">
  <div class="shell py-8 flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
    <nav aria-label="页脚导航" class="flex items-center gap-6">
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/resume`}
        class="t-small text-ink-muted hover:text-accent focus-visible:text-accent transition-colors duration-120"
      >
        在线简历
      </a>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="t-small text-ink-muted hover:text-accent transition-colors duration-120"
      >
        GitHub ↗
      </a>
      <a
        href={`mailto:${site.email}`}
        class="t-small text-ink-muted hover:text-accent transition-colors duration-120"
      >
        {site.email}
      </a>
    </nav>
    <div class="md:ml-auto flex items-center gap-6">
      <span class="hidden md:inline t-label text-ink-faint enhanced-only"
        >按 ⌘K 直达任意内容</span
      >
      <span class="t-label text-ink-faint">© {site.year} jary8</span>
    </div>
  </div>
</footer>
