---
import { site } from '../data/site';
---

<footer class="border-t border-line mt-8 md:mt-16 no-print">
  <div class="shell py-3 md:py-8 flex flex-wrap items-center gap-x-6 gap-y-2 md:flex-nowrap md:items-center md:gap-8">
    <nav aria-label="页脚导航" class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/resume`}
        class="t-small text-ink-muted hover:text-ink focus-visible:text-ink transition-colors duration-120 hidden md:inline-flex items-center min-h-[44px]"
      >
        在线简历
      </a>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="t-small text-ink-muted hover:text-ink transition-colors duration-120 inline-flex items-center min-h-[44px]"
      >
        GitHub ↗
      </a>
      <a
        href={`mailto:${site.email}`}
        class="t-small text-ink-muted hover:text-ink transition-colors duration-120 inline-flex items-center min-h-[44px] max-w-full [overflow-wrap:anywhere]"
      >
        {site.email}
      </a>
    </nav>
    <div class="md:ml-auto flex items-center gap-6">
      <!-- 外层 wrapper 负责断点（enhanced-only 的 unlayered 规则会压过 Tailwind hidden 工具类，不能同元素叠加） -->
      <span class="hidden md:inline"
        ><span class="t-label text-ink-faint enhanced-only">按 ⌘K 直达任意内容</span></span
      >
      <span class="t-label text-ink-faint">© {site.year} Jary</span>
    </div>
  </div>
</footer>
