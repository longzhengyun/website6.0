---
import { nav, relativePath, isActive } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const current = relativePath(Astro.url.pathname);
const desktopNav = nav.filter((n) => n.href !== '/');
---

<header class="border-b border-line no-print">
  <div class="shell flex items-center justify-between h-14">
    <a
      href={import.meta.env.BASE_URL}
      class="t-label text-ink arrow-link inline-flex items-center min-h-[44px]"
      aria-label="Jary 佳瑞网首页"
    >
      Jary<span class="brand-dot" aria-hidden="true"></span>佳瑞网
    </a>
    <div class="hidden md:flex items-center gap-8 ml-auto">
      <nav aria-label="主导航" class="flex items-center gap-8">
      {
        desktopNav.map((item) => (
          <a
            href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${item.href}`}
            class="t-label hover:text-ink transition-colors duration-120 inline-flex items-center min-h-[44px]"
            class:list={{
              'text-ink relative after:absolute after:inset-x-0 after:-bottom-1 after:h-[2px] after:bg-accent': isActive(
                item.href,
                current,
              ),
              'text-ink-muted': !isActive(item.href, current),
            }}
            aria-current={isActive(item.href, current) ? 'page' : undefined}
          >
            <span class="text-ink-faint mr-1">{item.num}/</span>
            <!-- M-13 rolling-text（07 册新增，04 册编号续）：双 span 同列叠放，hover 翻滚 180ms spring 自写；
                 第二枚 aria-hidden=读屏只读一遍；reduce/无动画=不翻滚（.roll 规则整体在 no-preference 闸门内） -->
            <span class="roll"><i>{item.label}</i><i aria-hidden="true">{item.label}</i></span>
          </a>
        ))
      }
      </nav>
      <ThemeToggle variant="header" />
    </div>
    <!-- F3-4（设计裁定 seq=1003，F2-01=B）：首页顶栏=无框弧排三点（☀/☾/◐，命中 44×44，
         浅弧 R≈90/角距 24°→矢高≈3px，簇 -3°）；仅 body.home-onescreen 且 JS 增强态显示
         （CSS .theme-arc 门控），内页沿用二期方框制式（范围总则：出格仅首页）。
         aria-pressed 由 theme.ts 同步当前档；点击=直接置档（零回退：Tab 序/语义保持） -->
    <div class="theme-arc" role="group" aria-label="主题模式">
      <button type="button" class="ta-btn" data-theme-set="light" aria-pressed="false" aria-label="亮色主题">☀</button>
      <button type="button" class="ta-btn" data-theme-set="dark" aria-pressed="false" aria-label="暗色主题">☾</button>
      <button type="button" class="ta-btn" data-theme-set="auto" aria-pressed="false" aria-label="跟随系统主题">◐</button>
    </div>
  </div>
</header>
