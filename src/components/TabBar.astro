---
import { nav, relativePath, isActive } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const current = relativePath(Astro.url.pathname);
// A（设计 seq=1025 观察项→seq=1033 排修）：tab 字面中文化=05 册定案「首页/资讯/关于+⌘K」；
// 仅 tab-bar 局部映射，不动共享 nav 数据（桌面 M-13 滚字判定面零触碰）；主题/⌘K 格制式保留
const tabZh: Record<string, string> = { '/': '首页', '/news': '资讯', '/about': '关于' };
---

<!-- F3-01（测试 seq=1030/项目 seq=1033）：五枚等分撑满（li flex-1，无 justify-around 间隙死区），
     每枚 ≥ 视口宽/5（375→75px）×56 高，elementFromPoint 全行落 a/button；BUG-M4-03 收缩制式
     （.tab-bar .tab-item flex:1 1 0+省略号）保持不变 -->
<nav aria-label="移动端导航" class="tab-bar md:hidden no-print">
  <ul class="h-14 flex items-stretch">
    {
      nav.map((item) => (
        <li class="flex min-w-0 flex-1">
          <a
            href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${item.href}`}
            class:list={[
              'tab-item t-label relative',
              isActive(item.href, current)
                ? 'text-ink relative before:absolute before:inset-x-3 before:top-0 before:h-[2px] before:bg-accent'
                : 'text-ink-muted',
            ]}
            aria-current={isActive(item.href, current) ? 'page' : undefined}
          >
            <span class="tab-label">{tabZh[item.href] ?? item.label}</span>
          </a>
        </li>
      ))
    }
    <li class="flex min-w-0 flex-1">
      <ThemeToggle variant="tab" />
    </li>
    <li class="flex min-w-0 flex-1">
      <button
        type="button"
        data-palette-open
        class="tab-item t-label enhanced-only text-ink-muted"
      >
        <span class="tab-label">⌘K</span>
      </button>
    </li>
  </ul>
</nav>
