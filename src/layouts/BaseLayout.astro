---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist/index.css';
import '@fontsource-variable/geist-mono/index.css';
import '../styles/theme.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TabBar from '../components/TabBar.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { news } from '../data/news';
import { relativePath, site } from '../data/site';
interface Props {
  title: string;
  desc: string;
  bare?: boolean;
  /** L-2 OG：传入即出 og/twitter 全套（相对 path，如 'og/og-home.png'；404 页不传=不出 OG） */
  ogImage?: string;
  ogTitle?: string;
  ogDesc?: string;
  /** 404 等不可索引页 */
  noindex?: boolean;
}

const { title, desc, bare = false, ogImage, ogTitle, ogDesc, noindex = false } = Astro.props;
// [L-2 spec §3.3 换绑替换点·项目 seq=261 口径] 绝对 URL 单一出处 = astro.config 的 site（CI 经 SITE_URL 变量注入）。
// 不硬编码域名或 '/website6.0/'：换绑时 devops 只改 site+base（一次 config/Variable 变更），
// OG/twitter 绝对 URL 即全站自动正确。前提不变式：site 含与 base 一致的路径前缀。
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const route = relativePath(Astro.url.pathname); // 去 base：'/' | '/news' | '/about' | '/resume'
const pageAbsoluteUrl = new URL(route === '/' ? '' : route.slice(1), siteUrl).toString();
const ogImageUrl = ogImage ? new URL(ogImage.replace(/^\/+/, ''), siteUrl).toString() : '';
const paletteIndex = [
  { label: 'Home 首页', href: '/' },
  { label: 'News 业内新闻', href: '/news' },
  { label: 'About 关于', href: '/about' },
  { label: 'Résumé 在线简历', href: '/resume' },
  { label: '切换主题（跟随系统 → 亮色 → 暗色）', action: 'theme-toggle' },
  ...news.items.slice(0, 12).map((i) => ({ label: i.title_zh, href: i.url, external: true })),
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // L-1 预绘：首帧前写入实际解析值（auto 也解析），杜绝 FOUC；与 theme.ts 的 SYNC:dark 两块 token 对应
      (function () {
        let mode = 'auto';
        try {
          const v = localStorage.getItem('theme-mode');
          if (v === 'light' || v === 'dark' || v === 'auto') mode = v;
        } catch { /* localStorage 不可用：保持 auto */ }
        const resolved = mode === 'auto'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : mode;
        const el = document.documentElement;
        el.setAttribute('data-theme', resolved);
        el.dataset.themeMode = mode;
      })();
    </script>
    <script>import '../scripts/theme';</script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      ogImage && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={`${site.nameEn} ${site.nameZh}`} />
          <meta property="og:locale" content="zh_CN" />
          <meta property="og:url" content={pageAbsoluteUrl} />
          <meta property="og:title" content={ogTitle ?? title} />
          <meta property="og:description" content={ogDesc ?? desc} />
          <meta property="og:image" content={ogImageUrl} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={ogTitle ?? title} />
          <meta name="twitter:description" content={ogDesc ?? desc} />
          <meta name="twitter:image" content={ogImageUrl} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <ClientRouter />
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:border focus:border-line focus:px-4 focus:py-2"
      >跳至主要内容</a
    >
    {
      bare ? (
        <></>
      ) : (
        <>
          <SiteHeader />
          <TabBar />
        </>
      )
    }
    <main id="main" class:list={[!bare && 'pb-24 md:pb-0']}>
      <slot />
    </main>
    {!bare && <SiteFooter />}
    <CommandPalette index={paletteIndex} />
  </body>
</html>
