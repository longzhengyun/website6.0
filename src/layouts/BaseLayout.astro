---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist/index.css';
import '@fontsource-variable/geist-mono/index.css';
import '../styles/fonts.css';
import '../styles/theme.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TabBar from '../components/TabBar.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { news } from '../data/news';
import { relativePath, site } from '../data/site';
interface Props {
  title: string;
  desc: string;
  bare?: boolean;
  /** L-2 OG：传入即出 og/twitter 全套（相对 path，如 'og/og-home.png'；404 页不传=不出 OG） */
  ogImage?: string;
  ogTitle?: string;
  ogDesc?: string;
  /** 404 等不可索引页 */
  noindex?: boolean;
  /** R-MHOME-1：M 端严格一屏页（首页专用）——去掉 pb-24 触屏留白，main 标 one-screen 供 global.css 消费 */
  oneScreen?: boolean;
}

const { title, desc, bare = false, ogImage, ogTitle, ogDesc, noindex = false, oneScreen = false } = Astro.props;
// [L-2 spec §3.3 换绑替换点·项目 seq=261 口径] 绝对 URL 单一出处 = astro.config 的 site（CI 经 SITE_URL 变量注入）。
// 不硬编码域名或 '/website6.0/'：换绑时 devops 只改 site+base（一次 config/Variable 变更），
// OG/twitter 绝对 URL 即全站自动正确。前提不变式：site 含与 base 一致的路径前缀。
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const route = relativePath(Astro.url.pathname); // 去 base：'/' | '/news' | '/about' | '/resume'
const pageAbsoluteUrl = new URL(route === '/' ? '' : route.slice(1), siteUrl).toString();
const ogImageUrl = ogImage ? new URL(ogImage.replace(/^\/+/, ''), siteUrl).toString() : '';
// FB-8-2（站主 seq=1277 裁③恒暗）：SYNC:FORCE_DARK 三处同值之一（本 frontmatter 过滤 ⌘K
// 主题条目 + 下方预绘内联脚本 + scripts/theme.ts）。置 false 整体放开，亮色 CSS 零删除。
const FORCE_DARK = true;
const paletteIndex = [
  { label: 'Home 首页', href: '/' },
  { label: 'News 业内新闻', href: '/news' },
  { label: 'About 关于', href: '/about' },
  { label: 'Résumé 在线简历', href: '/resume' },
  ...(FORCE_DARK
    ? []
    : [{ label: '切换主题（跟随系统 → 亮色 → 暗色）', action: 'theme-toggle' }]),
  ...news.items.slice(0, 12).map((i) => ({ label: i.title_zh, href: i.url, external: true })),
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // L-1 预绘：首帧前写入实际解析值（auto 也解析），杜绝 FOUC；与 theme.ts 的 SYNC:dark 两块 token 对应
      // FB-8-2：SYNC:FORCE_DARK 三处同值之二——true=恒暗，不读 localStorage（不擦除，放开后原偏好恢复）
      (function () {
        var FORCE_DARK = true;
        var el = document.documentElement;
        if (FORCE_DARK) {
          el.setAttribute('data-theme', 'dark');
          el.dataset.themeMode = 'dark';
          return;
        }
        let mode = 'auto';
        try {
          const v = localStorage.getItem('theme-mode');
          if (v === 'light' || v === 'dark' || v === 'auto') mode = v;
        } catch { /* localStorage 不可用：保持 auto */ }
        const resolved = mode === 'auto'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : mode;
        el.setAttribute('data-theme', resolved);
        el.dataset.themeMode = mode;
      })();
    </script>
    <script is:inline>
      // M-10 圆形扩散圆心（04 册）：任意指针按下即记录视口坐标 → --vt-x/--vt-y，
      // 转场时新页快照从该点 clip-path circle 展开；无 JS=默认 50% 圆心（CSS fallback）
      addEventListener('pointerdown', function (e) {
        const s = document.documentElement.style;
        s.setProperty('--vt-x', e.clientX + 'px');
        s.setProperty('--vt-y', e.clientY + 'px');
      }, { passive: true });
    </script>
    <script>import '../scripts/theme'; import '../scripts/local-reactions';</script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      ogImage && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={`${site.nameEn} ${site.nameZh}`} />
          <meta property="og:locale" content="zh_CN" />
          <meta property="og:url" content={pageAbsoluteUrl} />
          <meta property="og:title" content={ogTitle ?? title} />
          <meta property="og:description" content={ogDesc ?? desc} />
          <meta property="og:image" content={ogImageUrl} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={ogTitle ?? title} />
          <meta name="twitter:description" content={ogDesc ?? desc} />
          <meta name="twitter:image" content={ogImageUrl} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <ClientRouter />
  </head>
  <!-- R-FOOTER-1：sticky footer 骨架（flex 列 + main flex-1）；spine/TabBar 为 fixed 出流、CommandPalette 根 hidden，均不受影响
      F3（02 册）：home-onescreen=M 首页一屏构成专用（顶栏 44 无底线、页脚由 tab-bar 接管底部） -->
  <body class:list={['min-h-screen flex flex-col antialiased', oneScreen && 'home-onescreen']}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:border focus:border-line focus:px-4 focus:py-2"
      >跳至主要内容</a
    >
    {
      bare ? (
        <></>
      ) : (
        <>
          <SiteHeader />
          <TabBar />
        </>
      )
    }
    <!-- A6 书脊（§5.4：L-5 阅读进度的唯一可见进度件；纯 CSS scroll timeline，降级列见 global.css） -->
    {!bare && <div class="spine" aria-hidden="true"></div>}
    <main
      id="main"
      class:list={[
        !bare && !oneScreen && 'pb-24 md:pb-0',
        !bare && oneScreen && 'one-screen',
        !bare && 'flex-1',
      ]}
    >
      <slot />
    </main>
    {!bare && <SiteFooter />}
    <CommandPalette index={paletteIndex} />
  </body>
</html>
