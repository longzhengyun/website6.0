---
// [L-2 设计 spec §1] 终端风 404：等宽终端语言（虚线终端行 + 光标块），零新增 JS，三态主题 + no-JS 安全。
// 404 不出 OG（错误页无分享价值且 canonical 不成立）；robots noindex（spec §3.2）。
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 导航兜底沿用 SiteHeader 的 {num}/ {label} 制式（spec §1.3）
const fallbackNav = [
  { num: '01', href: '/', label: 'Home' },
  { num: '02', href: '/news', label: 'News' },
  { num: '03', href: '/about', label: 'About' },
  { num: '04', href: '/resume', label: 'Resume' },
];
---

<BaseLayout
  title={`404 · 页面不存在 — ${site.nameEn} ${site.nameZh}`}
  desc="页面不存在，或已被移动。以下地址仍然有效。"
  noindex
>
  <article class="shell flex min-h-[60vh] flex-col justify-center py-16">
    <h1 class="t-display flex items-baseline text-ink" aria-label="404 页面不存在">
      404<span class="ml-2 text-accent" aria-hidden="true">▍</span>
    </h1>

    <p
      class="t-label mt-8 inline-block border border-dashed border-line bg-surface px-4 py-3 text-ink"
    >
      &gt; 404 --not-found
    </p>

    <p class="t-body mt-6 text-ink-muted">页面不存在，或已被移动。</p>
    <p class="t-label mt-2 text-ink-faint">以下地址仍然有效：</p>

    <nav aria-label="导航兜底" class="mt-4 border border-line bg-surface px-4 py-2">
      <ul class="grid grid-cols-1 gap-x-8 md:grid-cols-4">
        {
          fallbackNav.map((item) => (
            <li>
              <a
                href={`${base}${item.href}`}
                class="arrow-link t-label inline-flex min-h-[44px] items-center gap-2 text-ink-muted transition-colors hover:text-ink"
              >
                <span class="shrink-0">{item.num}/</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="enhanced-only t-label mt-2 pb-2 text-ink-faint">或按 ⌘K 搜索全站</p>
    </nav>
  </article>
</BaseLayout>
