---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { skills, timeline } from '../data/about';
import { changelog } from '../data/changelog';

const blocks = (rank: number) =>
  Array.from({ length: 5 }, (_, i) => (i < rank ? '■' : '□'));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`关于 — ${site.nameZh} · ${site.nameEn}`}
  desc="关于 Jary：技能栈、履历时间线与在线简历入口。"
  ogTitle={`关于站长 — ${site.nameEn} ${site.nameZh}`}
  ogDesc="站长自述：web 前端开发工程师，本站是设计与工程的长期实验场。"
  ogImage="og/og-about.png"
>
  <article class="shell">
    <header class="pt-10 md:pt-16 pb-8">
      <p class="t-label spine-sense text-ink-muted uppercase">§03 / about</p>
      <h1 class="t-h1 zh-title mt-2">关于站长</h1>
    </header>

    <section aria-labelledby="self-title" class="mb-12 md:mb-16">
      <h2 id="self-title" class="sr-only">自述</h2>
      <p class="t-body max-w-[34em] text-balance">
        我是 Jary，web 前端开发工程师，「佳瑞网」的站长。这个站点本身就是我的技术履历——
        Astro 纯静态 + 可变字体与 scroll-driven 原生动效 + 构建期 AI 新闻管线，
        浏览器能做的最新的事，我都尽量做成每天可用的东西。{site.tagline}
      </p>
      <p class="t-small text-ink-muted mt-4 max-w-[42em]">
        隐私口径：新闻条目的已读标记与阅读进度为本地精选功能，只写入你浏览器的
        localStorage，数据不出本机——本站纯静态托管，无后端、无埋点、无任何回传。
      </p>
    </section>

    <section aria-labelledby="skills-title" class="mb-12 md:mb-16">
      <h2 id="skills-title" class="t-h2 zh-title mb-6">
        <span class="row-num t-label mr-3">01/</span>技能栈
      </h2>
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {
          skills.map((s) => (
            <li class="news-card p-4">
              <h3 class="t-h3">{s.name}</h3>
              <p class="rank-blocks t-label mt-2" aria-label={`熟练度 ${s.rank}/5`}>
                {blocks(s.rank).map((b) => (
                  <span class={b === '□' ? 'empty' : undefined} aria-hidden="true">
                    {b}
                  </span>
                ))}
              </p>
              <p class="t-small text-ink-muted mt-2">{s.note}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="timeline-title" class="mb-12 md:mb-16">
      <h2 id="timeline-title" class="t-h2 zh-title mb-6">
        <span class="row-num t-label mr-3">02/</span>履历时间线
      </h2>
      <ol class="border-l border-line ml-1">
        {
          timeline.map((t) => (
            <li class="pl-5 pb-8 relative">
              <p class="t-label text-ink-muted">{t.period}</p>
              <h3 class="t-h3 mt-1">
                {t.role}
                <span class="t-small text-ink-muted"> · {t.org}</span>
              </h3>
              <p class="t-small text-ink-muted mt-2 max-w-[42em]">{t.desc}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- N-1 站点迭代时间线区块（两级 IA：区块=索引、/changelog=全量五字段档案）。
         与 L-4 状态卡（现在）、N-5 导流位（能力）互链成工程叙事闭环。新条目只加数据不改本组件。 -->
    <section id="site-timeline" aria-labelledby="site-timeline-title" class="mb-12 md:mb-16 scroll-mt-6">
      <h2 id="site-timeline-title" class="t-h2 zh-title mb-6">
        <span class="row-num t-label mr-3">03/</span>站点迭代时间线
      </h2>
      {
        changelog.length === 0 ? (
          // 空态默认口径（站主 seq=422 裁定「空态文案按默认」）
          <p class="t-label text-ink-muted">［暂未公示 · 迭代档案整理中］</p>
        ) : (
          <>
            <ol class="border-l border-line ml-1">
              {changelog.map((e, i) => (
                <li class="pl-5 pb-8 relative">
                  <p class="t-label text-ink-muted">
                    {String(i + 1).padStart(2, '0')} · {e.date}
                  </p>
                  <h3 class="t-h3 mt-1">
                    {e.version}
                    <span class="t-small text-ink-muted"> · {e.theme}</span>
                  </h3>
                  {e.status && <p class="t-small text-ink-faint mt-1">{e.status}</p>}
                </li>
              ))}
            </ol>
            <a
              href={`${base}/changelog`}
              class="arrow-link t-label text-ink-muted hover:text-ink focus-visible:text-ink transition-colors inline-flex items-center gap-2 min-h-[44px]"
            >
              $ cat CHANGELOG.md（为什么做/证据链全档）<span class="arrow" aria-hidden="true">→</span>
            </a>
          </>
        )
      }
    </section>

    <!-- #design 锚点：N-5 导流行 $ cat DESIGN.md 的落地位（本批承载）。
         摘要取自 docs/design/DESIGN.md rev2（master 可核验），全文挂仓库 blob 外链。 -->
    <section id="design" aria-labelledby="design-title" class="mb-12 md:mb-16 scroll-mt-6">
      <h2 id="design-title" class="t-h2 zh-title mb-6">
        <span class="row-num t-label mr-3">04/</span>设计契约
      </h2>
      <ul class="grid gap-3 md:grid-cols-2">
        {
          [
            { t: '单一品牌色', d: '全站一个记忆点——朱红（暗 #f2555a / 亮 #e5484d）。亮暗是同一色相的明度适配，不是两套品牌。' },
            { t: '克制的炫技', d: '每个动效必须同时交付降级路径：reduce-motion / 低端机 / 无 JS 三列都写进契约，负责任比丰富更重要。' },
            { t: 'accent 是预算不是涂料', d: '每屏 ≤3 处；<18px 文字禁用 accent 着色——小字朱红不达 AA，这是数学不是偏好。' },
            { t: '零后端边界自守', d: '所有交互纯端侧：CSS / 原生 JS / localStorage / 构建期 JSON，无运行时外部请求，数据不出本机。' },
          ].map((p) => (
            <li class="news-card p-4">
              <h3 class="t-h3">{p.t}</h3>
              <p class="t-small text-ink-muted mt-2 max-w-[42em]">{p.d}</p>
            </li>
          ))
        }
      </ul>
      <p class="t-small text-ink-muted mt-4">
        全文（token 基线、字号阶梯、动效契约）：
        <a
          href="https://github.com/longzhengyun/website6.0/blob/master/docs/design/DESIGN.md"
          target="_blank"
          rel="noopener noreferrer"
          class="arrow-link text-ink hover:text-accent focus-visible:text-accent transition-colors inline-flex items-center gap-1 min-h-[44px]"
        >docs/design/DESIGN.md<span class="arrow" aria-hidden="true">↗</span></a
        >；演进过程见
        <a
          href={`${base}/changelog`}
          class="arrow-link text-ink hover:text-accent focus-visible:text-accent transition-colors inline-flex items-center gap-1 min-h-[44px]"
        >版本时间线<span class="arrow" aria-hidden="true">→</span></a
        >。
      </p>
    </section>

    <section aria-labelledby="ask-title" class="mb-12">
      <h2 id="ask-title" class="sr-only">问站长（实验位）</h2>
      <p class="ask-slot block px-4 py-3 text-[15px]" role="presentation">
        &gt; ask Jary --about
        <span class="t-label text-ink-muted ml-3">［实验位 · 端侧 RAG 问答 P1 建设中］</span>
      </p>
    </section>

    <section aria-labelledby="resume-link-title">
      <h2 id="resume-link-title" class="sr-only">简历入口</h2>
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/resume`}
        class="t-small text-ink-muted hover:text-ink focus-visible:text-ink transition-colors duration-120 arrow-link inline-flex items-center min-h-[44px]"
      >
        需要 PDF？→ 在线简历<span class="arrow" aria-hidden="true">↗</span>
      </a>
      <span class="t-label text-ink-muted ml-3">打印即导出</span>
    </section>
  </article>
</BaseLayout>
