---
import BaseLayout from '../layouts/BaseLayout.astro';
import CanvasLayer from '../components/CanvasLayer.astro';
import SignalField from '../components/SignalField.astro';
import GlyphTitle from '../components/GlyphTitle.astro';
import DemoTile from '../components/DemoTile.astro';
import VitalsOdometer from '../components/VitalsOdometer.astro';
import statsRaw from '../data/news-stats.json';
import { site } from '../data/site';
import { taglines } from '../data/taglines';
import { sortedItems } from '../data/news';
import { beijingDate, beijingMonthDay } from '../lib/date';

const latest = sortedItems.slice(0, 2);

// F2-3 D-3 暗格（01 册）：今日（北京时间口径）信号条数，构建期计数，零 JS；
// 0 → 「静默中」文案；条数翻牌 M-12 随 F2-5 接入
const todayBj = beijingDate(new Date().toISOString());
const signalsToday = sortedItems.filter((it) => beijingDate(it.published_at) === todayBj).length;

// F2-4 L2 终端舱六格（01 册「cat vitals.json → 六格实时工程状态」）：构建期 news-stats 快照，
// 与 VitalsCard 同源；SSR 直出终值，count-up 仅为首屏进视口一次性表演（l2-wall.ts）
const stats = statsRaw as unknown as {
  news_items_total: number;
  sources: unknown[];
  counts: { fetched: number; new_items: number; ai_enriched: number };
  llm: { calls: number };
};
const odoCells = [
  { label: '收录条目', value: stats.news_items_total },
  { label: 'RSS 源', value: stats.sources.length },
  { label: '本批抓取', value: stats.counts.fetched },
  { label: '本批新增', value: stats.counts.new_items },
  { label: 'AI 扩写', value: stats.counts.ai_enriched },
  { label: 'LLM 调用', value: stats.llm.calls },
];

// F2-4 L1 技能胶囊（01 册：五枚全胶囊各异旋转 + 两枚内嵌示波器 mini-canvas=技术展示本体）
const caps = [
  { name: 'React', rot: -3, scope: true },
  { name: 'WebGL', rot: 2.5, scope: true },
  { name: '动效工程', rot: -1.5, scope: false },
  { name: 'Astro', rot: 4, scope: false },
  { name: '无障碍工程', rot: -2, scope: false },
];

// F2-4：N-5 导流行（HAS_V3_CANVAS/guideItems）退役——4 链 + regenerate 全部升格进 L2 终端舱（07 册主舞台）；
// #vitals 锚点位由 L2 section 承接（史实兼容），M 端 375px 无 JS 内容入口=既有 md:hidden 新闻条（A4 承担者不动）
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`${site.nameZh} · ${site.nameEn} — ${site.tagline}`}
  desc="web 前端工程师 Jary 的个人站：前沿前端技术与 AI 结合的落地实践。"
  ogTitle={`Jary 佳瑞网 — ${site.tagline}`}
  ogDesc="web 前端开发工程师个人技术站点：Astro 静态站、暗色三态、命令面板、RSS+AI 资讯自动管线。"
  ogImage="og/og-home.png"
  oneScreen
>
  <article class="m-home">
    <!-- Hero：站名版式 L1「双语叠印」（design-spec §3）+ 单一视觉焦点=字体呼吸；
         R15 单屏：移动 hero 在 tab 条上方可视区内垂直居中（100svh 防 iOS 地址栏跳动）；
         R-MHOME-1(D2a)：M 端静帧并入 hero 背景层（零独立高度），id=v3-canvas 上移到 section
         使 D/M 两档锚点均可命中（N-5 第 4 链落点）；R-MHOME-1(A)：M 端 flex-1 吸收一屏余量，
         pb 64→32 收容器留白，字号按 R5 裁定不动 -->
    <section
      id="v3-canvas"
      class="shell shell-wide relative pt-[20vh] pb-16 md:pb-16 md:min-h-[100svh] max-md:flex-1 max-md:pb-8 max-md:pt-0 max-md:flex max-md:flex-col max-md:justify-center"
      aria-labelledby="hero-title"
    >
      <!-- F2-1 D 端 L0 安静 mesh 场（01 册 L0 × 07 册 §4-01：同 shader 链路降亮 ≤0.06、去粒子、
           流速减半、grain、信标 3→1）；二期 V3 hero 折线层在 D 档退役（N-3 链保留至 F3 收口：
           strip 仍为 M 端 hero 背景，#v3-canvas 锚点位不变=section 本身） -->
      <SignalField />
      <!-- V3 M 端静帧（R-MHOME-1 D2a 并入 hero 背景）：同 seed 0x5EED、alpha 带 0.04–0.14、
           叠印语义不变；D 端 CSS 隐藏（原 40vh 独立条位退役，零高度成本） -->
      <CanvasLayer variant="strip" />
      <h1 id="hero-title" class="t-display">
        <span class="md:hidden zh-title block text-[2.25rem]! leading-[1.2]">佳瑞网</span>
        <span
          class="md:hidden hero-en-mono t-label text-[0.875rem]! inline-block mt-2 border-b-2 border-accent pb-1"
        >
          Jary
        </span>
        <!-- F2-2 D 端大标图片化（03 册主案 × 07 册排版律）：实色白 900 SVG 转曲「佳瑞网」+ 信标红点挂件，
             -3° 斜置（01 册 L0）；JARY 保留为 mono 签名层（03 册中文优先）；
             删除原「Jary·佳瑞网」文本大标与 text-accent 圆点（霓虹/高亮位让位）。
             F2-3：D 端挂 L0 绝对舞台（12vw/30vh，CSS .l0-title）；M 端流内制式不动 -->
        <span class="hidden md:inline l0-title">
          <span class="hero-title-d block">
            <GlyphTitle text="佳瑞网" beacon />
          </span>
          <span class="hero-jary-sign t-label">JARY · WEB FRONT-END ENGINEER</span>
        </span>
      </h1>
      <!-- F2-2：D 端 role 行并入大标下 mono 签名（去重复）；L0 副标「让信号穿越噪声」上首屏
           （01 册：细体 +1.5°；手写感细体无授权字源→细字重+宽字距替代，随 F2 回报备案）；M 端既有 role 行保留至 F3 -->
      <p class="t-h2 text-ink-muted mt-6 max-w-[34em] md:hidden">
        {site.role}
      </p>
      <p class="hero-sub-d">让信号穿越噪声</p>
      <!-- R16 三行制轮播副行：SSR 渲池首条（无 JS 稳定降级），同步内联脚本首帧前原位替换随机条目；
           固定单行行盒防 CLS；window 级记忆=整页刷新重抽、ClientRouter 站内跳转不重抽；不进 aria-live -->
      <p class="t-label text-ink-muted mt-3 tagline-line">
        <span aria-hidden="true">▍</span><span id="tagline-text">{taglines[0]}</span>
      </p>
      <script type="application/json" id="tagline-pool" set:html={JSON.stringify(taglines).replace(/</g, '\\u003c')} />
      <script is:inline>
        (function () {
          const el = document.getElementById('tagline-text');
          const pool = document.getElementById('tagline-pool');
          if (!el || !pool) return;
          if (window.__tagline === undefined) {
            try {
              const arr = JSON.parse(pool.textContent);
              window.__tagline = arr[Math.floor(Math.random() * arr.length)];
            } catch (e) {
              window.__tagline = null;
            }
          }
          if (window.__tagline) el.textContent = window.__tagline;
        })();
      </script>

      <!-- F2-3 L0 演示瓦片×3（01 册胶囊位 × 07 册「演示即内容」参数可见化 × 08 册案 A 光影拼框）：
           ①弹簧=自写半隐式欧拉 k260/d20/m1（04 册弹簧族）②时间轴=纯 CSS 4.2s linear 扫掠
           ③手势=pointer 60pt 渐隐路径 + 空闲 Lissajous 自走；canvas/装饰均 aria-hidden，
           语义由 caption+param 文字承载（H4：瓦内文字恒定 ink 系，彩色仅图形件 ≥3:1）。
           动画全部受 l0-tiles.ts reduce/低端单帧闸与全局 reduced-motion 总闸约束；M 端整层不渲染（F3 另案） -->
      <DemoTile
        tileId="spring"
        edge="var(--c-demo-1)"
        caption="弹簧回弹"
        param="k260 · d20 · m1"
        class="l0-tile-spring"
      >
        <canvas aria-hidden="true"></canvas>
      </DemoTile>
      <DemoTile
        tileId="timeline"
        edge="var(--c-demo-3)"
        caption="时间轴轨道"
        param="4.2s · linear"
        class="l0-tile-timeline"
      >
        <div class="tl-wrap" aria-hidden="true">
          <span class="tl-line" style="top: 24%"></span>
          <span class="tl-line" style="top: 50%"></span>
          <span class="tl-line" style="top: 76%"></span>
          <span class="tl-head"></span>
        </div>
      </DemoTile>
      <DemoTile
        tileId="gesture"
        edge="var(--c-demo-4)"
        caption="手势路径"
        param="trail 60pt"
        class="l0-tile-gesture"
      >
        <canvas aria-hidden="true"></canvas>
      </DemoTile>
      <!-- F2-3 D-3 暗格：今日（北京时间）信号条数，构建期计数；整格=→ /news 链接；翻牌动效随 F2-5 -->
      <a class="l0-darkcell" href={`${base}/news`}>
        <span class="l0-dc-num">{signalsToday > 0 ? String(signalsToday) : '0'}</span>
        <span class="l0-dc-label">
          {signalsToday > 0 ? `条信号 · 今日 ${todayBj}` : '静默中 · 今日无新信号'}
        </span>
      </a>
    </section>

    <!-- R-MHOME-1(D2a)：M 端静帧已并入上方 hero 背景层，独立 40vh 条位退役 -->

    <!-- R-MHOME-1(A)：M 端新闻条 1 条制式（标题 truncate/日期/↗ 与 D 端及 /news 一致）；
         SSR 直出零 JS；D 端由下方既有超紧凑双条 bar 承载，互不重叠 -->
    {
      latest.length > 0 && (
        <section class="shell md:hidden" aria-labelledby="pulse-m-title">
          <h2 id="pulse-m-title" class="sr-only">最新新闻速览</h2>
          <div class="border-t border-line pt-3">
            <a href={latest[0].url} target="_blank" rel="noopener noreferrer" class="block min-w-0">
              <p class="t-small text-ink arrow-link flex items-baseline gap-2 min-w-0">
                <span class="row-num t-label shrink-0">01/</span>
                <span class="truncate">{latest[0].title_zh}</span>
                <span class="arrow text-[0.7em] shrink-0" aria-hidden="true">↗</span>
              </p>
              <p class="t-label text-ink-muted mt-1">{beijingMonthDay(latest[0].published_at)}</p>
            </a>
            <p class="t-label mt-2">
              <a
                class="arrow-link text-ink-muted hover:text-ink transition-colors inline-flex items-center gap-2 min-h-[44px]"
                href={`${base}/news`}
              >全部新闻 →</a
              >
            </p>
          </div>
        </section>
      )
    }

    <!-- F2-4 L1 能力光谱（01 册 L1 × 07 册 v2.1）：编辑式短句节题（带句号，GlyphTitle 转曲字集 v2 扩
         动/的/中/文/直/读/。）+ 每项配微型活演示 + M-15 滚动 scrub 进场（animation-timeline: view()，
         不支持=静态可见；reduce 总闸 no-preference 闸门）。技能胶囊群五枚全胶囊各异旋转（01 册禁栅格），
         星座连线 path draw-on 由 scrub 驱动，两枚内嵌示波器 mini-canvas=技术展示本体。
         D 档专属（max-md:hidden，M 档一屏制式保留至 F3）；旧 N-5 导流行/vitals 卡内容迁 L2 终端舱（07 册升格主舞台）。 -->
    <section id="spectrum" class="shell shell-wide max-md:hidden l1-sec" aria-labelledby="l1-title">
      <h2 id="l1-title" class="l1-glyph">
        <GlyphTitle text="能力光谱" />
      </h2>
      <div class="l1-row l1-row-a">
        <span class="l1-statement"><GlyphTitle text="动的信号。" /></span>
        <!-- 微型演示①=scrub 本体：方块旋转/进度点随滚动直读（M-15 演示即内容） -->
        <span class="l1-mini" aria-hidden="true">
          <span class="scrub-box"></span>
          <span class="scrub-rail"><span class="scrub-dot"></span></span>
          <span class="mini-cap">M-15 · view()</span>
        </span>
      </div>
      <div class="l1-caps">
        <svg class="l1-links" viewBox="0 0 1000 220" preserveAspectRatio="none" aria-hidden="true">
          <path pathLength="1" d="M70 160 L260 50 L470 175 L660 60 L900 140" />
        </svg>
        {
          caps.map((c) => (
            <span class="cap" style={`--rot:${c.rot}deg`}>
              {c.scope && <canvas data-scope aria-hidden="true"></canvas>}
              <span>{c.name}</span>
            </span>
          ))
        }
      </div>
      <div class="l1-row l1-row-b">
        <span class="l1-statement"><GlyphTitle text="中文直读。" /></span>
        <!-- 微型演示②=scramble 解码：RSS→AI 中文扩写的叙事本体；SSR=终值可读，无 JS 不表演 -->
        <span class="l1-mini" aria-hidden="true">
          <span class="scramble" data-scramble="RSS 直连 · 中文直读 · 把噪声滤成结构">RSS 直连 · 中文直读 · 把噪声滤成结构</span>
          <span class="mini-cap">M-05 · decode</span>
        </span>
      </div>
    </section>

    <!-- F2-4 L2 演示墙（01 册「工程信号台」× 07 册 bento 升级）：终端舱吸收 N-5 导流行全部 4 链 +
         vitals（cat vitals.json 六格 odometer）+ changelog 闭环 + regenerate seed 画布件；
         12 动效矩阵复用为格内容（stagger/scrub/blur/draw/磁吸演示）；宽/高/旋转卡各≥1（bento 不等大）；
         瓦缘=08 册案 B：WallField shader 按矩形 SDF 统一驱动（.wf-canvas 覆盖层，l2-wall.ts）；
         M-14 磁吸 ±12px 全格生效。id=vitals 保留（N-5 锚点史实兼容）。D 档专属，M 档 F3 另案。 -->
    <section id="vitals" class="shell shell-wide max-md:hidden l2-sec scroll-mt-6" aria-labelledby="l2-title">
      <h2 id="l2-title" class="l2-glyph">
        <GlyphTitle text="工程信号台" />
      </h2>
      <p class="l2-lede t-h2 text-ink-muted">演示即内容 —— 每格一个活演示、一段代码或一格数据。</p>
      <div class="wall" data-wall>
        <canvas class="wf-canvas" data-wf aria-hidden="true"></canvas>
        <div class="cell cell-term" data-cell data-edge="--c-demo-3">
          <div class="term" data-term>
            <p class="t-line"><span class="t-p" aria-hidden="true">$</span> <span class="t-cmd">open /docs</span> <span class="t-out">→ <a class="arrow-link t-link" href={`${base}/about#design`}>DESIGN.md 设计契约</a></span></p>
            <p class="t-line"><span class="t-p" aria-hidden="true">$</span> <span class="t-cmd">whoami</span> <span class="t-out">→ jary · {site.role}</span></p>
            <p class="t-line"><span class="t-p" aria-hidden="true">$</span> <span class="t-cmd">cat vitals.json</span> <span class="t-out">→ 六格工程状态 · 构建期快照（北京 {beijingDate(new Date().toISOString())}）</span></p>
            <VitalsOdometer cells={odoCells} class="term-odo" />
            <p class="t-line"><span class="t-p" aria-hidden="true">$</span> <span class="t-cmd">tail -f feed</span> <span class="t-out">→ {latest.length > 0 ? latest[0].title_zh : '静默中'} <a class="arrow-link t-link" href={`${base}/news`}>/news 全部 →</a></span></p>
            <p class="t-line"><span class="t-p" aria-hidden="true">$</span> <span class="t-cmd">cat changelog</span> <span class="t-out">→ <a class="arrow-link t-link" href={`${base}/changelog`}>迭代档案（N-1 闭环）</a></span></p>
            <p class="t-line"><span class="t-p" aria-hidden="true">$</span> <button type="button" data-v3-regen class="t-cmd t-regen">regenerate seed</button> <span class="t-out">→ 换 ?seed= 重算 L0 信号场</span></p>
          </div>
        </div>
        <div class="cell cell-code" data-cell data-edge="--c-demo-4">
          <pre class="code"><code><span class="tk-c">// 弹簧族 · 本站自写半隐式欧拉（04 册）</span>
<span class="tk-k">const</span> <span class="tk-f">spring</span> = &#123; k: <span class="tk-n">260</span>, d: <span class="tk-n">20</span>, m: <span class="tk-n">1</span> &#125;
<span class="tk-f">animate</span>(ball, &#123; x: <span class="tk-n">220</span>, transition: spring &#125;)</code></pre>
          <span class="cell-cap">code · 参数可见化</span>
        </div>
        <div class="cell cell-stagger" data-cell data-edge="--c-demo-1">
          <span class="stg" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          <span class="cell-cap">stagger · 交错入场</span>
        </div>
        <div class="cell cell-blur" data-cell data-edge="--c-demo-2">
          <span class="blur-word" aria-hidden="true">信号</span>
          <span class="cell-cap">blur-in · 模糊聚焦</span>
        </div>
        <div class="cell cell-draw" data-cell data-edge="--c-demo-5">
          <svg class="draw-svg" viewBox="0 0 220 90" aria-hidden="true">
            <path pathLength="1" d="M8 70 C 60 10, 90 92, 130 44 S 200 18, 212 60" />
          </svg>
          <span class="cell-cap">draw-on · 路径描画</span>
        </div>
        <div class="cell cell-scrub" data-cell data-edge="--c-demo-3">
          <span class="scrub-box big" aria-hidden="true"></span>
          <span class="cell-cap">scrub · 滚动直读</span>
        </div>
        <div class="cell cell-magnet" data-cell data-edge="--c-demo-6">
          <span class="mag-ball" aria-hidden="true"></span>
          <span class="cell-cap">magnet · M-14 磁吸</span>
        </div>
      </div>
    </section>
  </article>
  <!-- N-3/F2-1 客户端：仅首页引用 → 独立小 chunk。load/astro:page-load 后动态 import：
       不进 modulepreload、不与首屏字体/LCP 抢带宽（实测静态 import 时 LCP Δ≈+45ms，改此法 Δ≈0，见回执）；
       模块内部自绑 astro:page-load，SPA 进出首页正常重初始化。
       F2-1：v3-canvas（M 端 strip 静帧+regen 写 URL 职责）与 signal-field（D 端 L0 场）并行装载；
       F2-3：l0-tiles（瓦片光带呼吸 + spring/手势 canvas，D-only）随批装载；
       F2-4：l2-wall（案 B WallField shader + M-14 磁吸 + 终端打字 + odometer + scramble + 示波器） -->
  <script>
    const once = () => {
      import('../scripts/v3-canvas');
      import('../scripts/signal-field');
      import('../scripts/l0-tiles');
      import('../scripts/l2-wall');
    };
    window.addEventListener('load', once, { once: true });
    document.addEventListener('astro:page-load', once, { once: true });
  </script>
</BaseLayout>
