---
import BaseLayout from '../layouts/BaseLayout.astro';
import VitalsCard from '../components/VitalsCard.astro';
import { site } from '../data/site';
import { taglines } from '../data/taglines';
import { sortedItems } from '../data/news';

const latest = sortedItems.slice(0, 2);

// N-5 导流行（shared/t2-n3n5-homepage-proposal.md rev1.1 §3）：SSR 静态零 JS。
// 断链过渡（项目 seq=474-②，§3 预案二选一取「SSR 条件隐藏」）：$ open canvas? 在 N-3 画布合入前不渲染，
// 合入时本常量翻 true 即恢复；不选「改指 /about 说明位」因说明位涉文案撰写（R6 公开粒度归产品口径）。
// ↻ regenerate 尾链属画布交互件，随 N-3 批次出现，本批零 JS 边界不预埋。
const HAS_V3_CANVAS = false;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guideItems = [
  { cmd: 'cat DESIGN.md', href: `${base}/about#design` },
  { cmd: 'ls heartbeat', href: '#vitals' },
  { cmd: 'tail -f feed', href: `${base}/news` },
  ...(HAS_V3_CANVAS ? [{ cmd: 'open canvas?', href: '#v3-canvas' }] : []),
];
---

<BaseLayout
  title={`${site.nameZh} · ${site.nameEn} — ${site.tagline}`}
  desc="web 前端工程师 Jary 的个人站：前沿前端技术与 AI 结合的落地实践。"
  ogTitle={`Jary 佳瑞网 — ${site.tagline}`}
  ogDesc="web 前端开发工程师个人技术站点：Astro 静态站、暗色三态、命令面板、RSS+AI 资讯自动管线。"
  ogImage="og/og-home.png"
>
  <article>
    <!-- Hero：站名版式 L1「双语叠印」（design-spec §3）+ 单一视觉焦点=字体呼吸；
         R15 单屏：移动 hero 在 tab 条上方可视区内垂直居中（100svh 防 iOS 地址栏跳动） -->
    <section
      class="shell shell-wide pt-[20vh] pb-16 md:pb-16 max-md:min-h-[calc(100svh-300px)] max-md:pt-0 max-md:flex max-md:flex-col max-md:justify-center"
      aria-labelledby="hero-title"
    >
      <h1 id="hero-title" class="t-display">
        <span class="md:hidden zh-title block text-[2.25rem]! leading-[1.2]">佳瑞网</span>
        <span
          class="md:hidden hero-en-mono t-label text-[0.875rem]! inline-block mt-2 border-b-2 border-accent pb-1"
        >
          Jary
        </span>
        <span class="hidden md:inline">
          <span class="hero-en">Jary</span><span class="text-accent">·</span><span
            class="zh-title">佳瑞网</span
          >
        </span>
      </h1>
      <p class="t-h2 text-ink-muted mt-6 max-w-[34em]">
        {site.role}
      </p>
      <!-- R16 三行制轮播副行：SSR 渲池首条（无 JS 稳定降级），同步内联脚本首帧前原位替换随机条目；
           固定单行行盒防 CLS；window 级记忆=整页刷新重抽、ClientRouter 站内跳转不重抽；不进 aria-live -->
      <p class="t-label text-ink-muted mt-3 tagline-line">
        <span aria-hidden="true">▍</span><span id="tagline-text">{taglines[0]}</span>
      </p>
      <script type="application/json" id="tagline-pool" set:html={JSON.stringify(taglines).replace(/</g, '\\u003c')} />
      <script is:inline>
        (function () {
          const el = document.getElementById('tagline-text');
          const pool = document.getElementById('tagline-pool');
          if (!el || !pool) return;
          if (window.__tagline === undefined) {
            try {
              const arr = JSON.parse(pool.textContent);
              window.__tagline = arr[Math.floor(Math.random() * arr.length)];
            } catch (e) {
              window.__tagline = null;
            }
          }
          if (window.__tagline) el.textContent = window.__tagline;
        })();
      </script>
    </section>

    <!-- N-5 技术亮点导流行：hero 下缘、脉动条上方；D 端单行 flex / M 端两行竖排（grid-2）。
         A4 锁定句（产品比对 seq=444-③）：本行=375px 无 JS 场景内容入口承担者，删除/降级须重判 A4（只做加法）。
         制式：$ … mono t-label 终端语言（404/OG 同源）+ arrow-link hover A4 参数；命中区 M 端 ≥44px。
         同页锚点口径（n5-hash-probe2 双向对照）：不加 data-astro-reload——ClientRouter 对同页 hash
         链接拦截后仍原生滚到锚点（真实点击 scrollY/hash 均正确）；曾观测“不滚动”为探针几何伪影
         （400px 视口下点击坐标落在视口外，命中为空）。测试 A7'-5 可达断言按此口径。 -->
    <section class="shell pb-12 md:pb-4" aria-labelledby="guide-title">
      <h2 id="guide-title" class="sr-only">技术亮点</h2>
      <nav
        aria-label="技术亮点导流"
        class="grid grid-cols-2 items-baseline gap-x-8 border-t border-line pt-4 md:flex md:gap-y-0"
      >
        {
          guideItems.map((g) => (
            <a
              href={g.href}
              class="arrow-link t-label inline-flex min-h-[44px] items-center gap-2 text-ink-muted transition-colors hover:text-ink md:min-h-0"
            >
              <span class="text-ink-faint" aria-hidden="true">
                $
              </span>
              <span>{g.cmd}</span>
              <span class="arrow text-[0.7em] shrink-0" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </nav>
    </section>

    <!-- R15 桌面超紧凑新闻动态条（≤64px、单行两项、仅标题级）；移动端由同步脚本整块移出 DOM（非隐藏） -->
    {
      latest.length > 0 && (
        <section class="shell hidden md:block" data-home-pulse aria-labelledby="pulse-title">
          <h2 id="pulse-title" class="sr-only">最新新闻速览</h2>
          <div class="flex items-baseline gap-8 border-t border-line pt-3">
            {latest.map((item, i) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="min-w-0 flex-1 block"
              >
                <p class="t-small text-ink arrow-link flex items-baseline gap-2 min-w-0">
                  <span class="row-num t-label shrink-0">
                    {String(i + 1).padStart(2, '0')}/
                  </span>
                  <span class="truncate">{item.title_zh}</span>
                  <span class="arrow text-[0.7em] shrink-0" aria-hidden="true">↗</span>
                </p>
                <p class="t-label text-ink-muted mt-1">{item.published_at.slice(5, 10)}</p>
              </a>
            ))}
            <a
              class="arrow-link shrink-0 t-label text-ink-muted hover:text-ink transition-colors"
              href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/news`}
            >
              全部新闻 →
            </a>
          </div>
        </section>
      )
    }
    <script is:inline>
      (function () {
        if (!window.matchMedia('(min-width: 768px)').matches) {
          const el = document.querySelector('[data-home-pulse]');
          if (el) el.parentNode.removeChild(el);
        }
      })();
    </script>

    <!-- L-4：工程状态卡收进独立 shell 版心，随 hero section 的既有间距节奏落底；
         id=vitals 为 N-5 `$ ls heartbeat` 同页锚点（rev1.1 §3） -->
    <section id="vitals" class="shell mt-8 md:mt-10 scroll-mt-6" aria-label="站点工程状态">
      <VitalsCard />
    </section>
  </article>
</BaseLayout>
