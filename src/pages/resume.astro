---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../data/resume';
import { site } from '../data/site';
---

<BaseLayout
  title={`在线简历 — ${resume.name}`}
  desc="Jary 的在线简历：网页为主，打印导出 PDF。"
  ogTitle={`履历 — ${site.nameEn} ${site.nameZh}`}
  ogDesc="Jary 的职业履历与技术栈档案。"
  ogImage="og/og-resume.png"
  bare
>
  <div class="shell py-4 flex items-center justify-between no-print">
    <a
      href={import.meta.env.BASE_URL}
      class="tab-item t-label text-ink arrow-link"
      style="min-width:44px;min-height:44px;display:inline-flex"
    >
      ← Jary
    </a>
    <button
      type="button"
      class="chip t-label enhanced-only"
      data-print
    >
      打印 / 导出 PDF
    </button>
  </div>

  <article class="shell max-w-[680px] pb-24 md:pb-16">
    <header class="mb-8">
      <h1 class="t-h1 zh-title">{resume.name}</h1>
      <p class="t-h3 text-ink-muted mt-1">{resume.title}</p>
      <p class="t-label text-ink-muted mt-3">
        <a
          href={`mailto:${resume.contact.email}`}
          class="hover:text-ink [overflow-wrap:anywhere]"
          data-print-url={resume.contact.email}
        >{resume.contact.email}</a
        >
        ·
        <a
          href={resume.contact.github}
          class="hover:text-ink [overflow-wrap:anywhere]"
          data-print-url={resume.contact.github}
          >github.com/longzhengyun</a
        >
      </p>
      <p class="t-label text-ink-muted mt-3">{resume.meta}</p>
    </header>

    <section class="resume-section mb-8" aria-labelledby="r-summary">
      <h2 id="r-summary" class="t-label uppercase text-ink-muted border-b border-line pb-2 mb-4">
        Summary
      </h2>
      <p class="t-body max-w-[42em]">{resume.summary}</p>
    </section>

    <section class="resume-section mb-8" aria-labelledby="r-skills">
      <h2 id="r-skills" class="t-label uppercase text-ink-muted border-b border-line pb-2 mb-4">
        Core Skills
      </h2>
      {
        resume.skills.map((g) => (
          <div class="mb-3">
            <h3 class="t-h3">{g.group}</h3>
            <p class="t-body text-ink-muted mt-1">
              {g.items.map((it) => `${it.name}（${it.level}）`).join(' · ')}
            </p>
          </div>
        ))
      }
    </section>

    <section class="resume-section mb-8" aria-labelledby="r-exp">
      <h2 id="r-exp" class="t-label uppercase text-ink-muted border-b border-line pb-2 mb-4">
        Experience
      </h2>
      {
        resume.experience.length > 0 ? (
          resume.experience.map((e) => (
            <div class="mb-6">
              <h3 class="t-h3">
                {e.role} <span class="t-small text-ink-muted">· {e.org}</span>
              </h3>
              <p class="t-label text-ink-muted md:text-right">{e.period}</p>
              <ul class="t-body text-ink-muted mt-2 list-disc pl-5">
                {e.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))
        ) : (
          <p class="t-small text-ink-muted">{resume.emptyNote}</p>
        )
      }
    </section>

    <section class="resume-section mb-8" aria-labelledby="r-projects">
      <h2 id="r-projects" class="t-label uppercase text-ink-muted border-b border-line pb-2 mb-4">
        Selected Projects
      </h2>
      {
        resume.projects.map((p) => (
          <div class="mb-4">
            <h3 class="t-h3">
              {p.name} <span class="t-label text-ink-muted md:text-right">{p.period}</span>
            </h3>
            <p class="t-small text-ink-muted mt-1">{p.desc}</p>
          </div>
        ))
      }
    </section>

    <section class="resume-section" aria-labelledby="r-edu">
      <h2 id="r-edu" class="t-label uppercase text-ink-muted border-b border-line pb-2 mb-4">
        Education
      </h2>
      {
        resume.education.length > 0 ? (
          resume.education.map((ed) => (
            <p class="t-body">
              {ed.school} <span class="t-label text-ink-muted">{ed.period}</span>
            </p>
          ))
        ) : (
          <p class="t-small text-ink-muted">{resume.emptyNote}</p>
        )
      }
    </section>
  </article>

  <script>
    document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => {
      window.print();
    });
  </script>
</BaseLayout>
